# Telegram Bot Token (отримати у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key (отримати безкоштовно на https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Часовий пояс (за замовчуванням Europe/Kyiv)
TIMEZONE=Europe/Kyiv

# Шлях до бази даних SQLite
DATABASE_PATH=med_bot.db
